{
  "name": "askai-button",
  "version": "0.1.0",
  "description": "A floating \"Ask AI\" button that hands the visitor's question and your site URL to ChatGPT, Claude or Google AI Mode. No API, no server, no tracking.",
  "license": "MIT",
  "author": "Elephancube Inc.",
  "homepage": "https://elephancube.github.io/askai-button/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/elephancube/askai-button.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/elephancube/askai-button/issues"
  },
  "keywords": [
    "ai",
    "ask-ai",
    "chatgpt",
    "claude",
    "google-ai-mode",
    "button",
    "widget",
    "floating-button",
    "i18n",
    "no-dependencies"
  ],
  "type": "module",
  "main": "./dist/askai-button.esm.js",
  "module": "./dist/askai-button.esm.js",
  "types": "./dist/types/index.d.ts",
  "unpkg": "./dist/askai-button.min.js",
  "jsdelivr": "./dist/askai-button.min.js",
  "exports": {
    ".": {
      "types": "./dist/types/index.d.ts",
      "import": "./dist/askai-button.esm.js",
      "default": "./dist/askai-button.esm.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist"
  ],
  "sideEffects": true,
  "publishConfig": {
    "access": "public"
  },
  "scripts": {
    "build": "vite build && tsc -p tsconfig.build.json && node scripts/fix-dts.mjs && node scripts/size.mjs",
    "prepack": "npm run typecheck && npm test && npm run build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  }
}
